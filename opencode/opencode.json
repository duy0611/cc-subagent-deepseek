{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/deepseek-v4.1-flash",
  "small_model": "litellm/deepseek-v4.1-flash",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "cost": {
            "input": 4,
            "output": 20,
            "cache_read": 0.2
          }
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5",
          "cost": {
            "input": 2,
            "output": 10,
            "cache_read": 0.2
          }
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5",
          "cost": {
            "input": 0.1,
            "output": 0.5
          }
        },
        "deepseek-v4.1-flash": {
          "name": "DeepSeek 4.1 Flash",
          "cost": {
            "input": 0.15,
            "output": 0.6,
            "cache_read": 0.003
          }
        }
      }
    }
  }
}
